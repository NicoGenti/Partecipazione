# Variabili per il frontend (iniettate da Vite al momento del build)
# ---------------------------------------------------------------
# Queste variabili vengono iniettate al momento del build tramite
# GitHub Secrets (vedi .github/workflows/deploy.yml).
# Per lo sviluppo locale crea un file .env.local con i valori reali.
#
# NOTA DI SICUREZZA: nessun token SAS deve mai finire nel bundle.
# Le scritture avvengono tramite le Azure Functions (VITE_API_BASE_URL);
# le foto e gli asset statici sono letti tramite URL pubblici anonimi.

# URL base della Azure Function App (senza trailing slash)
# Es. https://nome-function-app.azurewebsites.net
VITE_API_BASE_URL=

# URL base dell'account Azure Storage (senza trailing slash)
# Usato solo per costruire URL pubblici di lettura di foto e asset statici.
# Es. https://nomestorageaccount.blob.core.windows.net
VITE_AZURE_ACCOUNT_URL=

# Nome del container Blob dove risiedono foto e asset statici (accesso pubblico in lettura)
# Es. matrimonioblob
VITE_AZURE_CONTAINER=

# Abilita il watermark sulle foto caricate (true/false)
VITE_WATERMARK_ENABLED=false

# Endpoint della dashboard admin (funzione già esistente, protetta da X-Admin-Key)
VITE_DASHBOARD_ENDPOINT=
