{
  "bindings": [
    {
      "name": "req",
      "type": "httpTrigger",
      "direction": "in",
      "methods": ["post", "options"],
      "authLevel": "anonymous",
      "route": "photo",
      "dataType": "binary"
    },
    {
      "name": "$return",
      "type": "http",
      "direction": "out"
    }
  ],
  "scriptFile": "../dist/PhotoUpload/index.js"
}
