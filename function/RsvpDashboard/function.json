{
  "bindings": [
    {
      "name": "req",
      "type": "httpTrigger",
      "direction": "in",
      "methods": ["get"],
      "authLevel": "anonymous",
      "route": "rsvp-dashboard"
    },
    {
      "name": "$return",
      "type": "http",
      "direction": "out"
    }
  ],
  "scriptFile": "../dist/RsvpDashboard/index.js"
}